# copilot-api — canonical NON-SECRET container env (git-committed, host-AGNOSTIC).
# Assembled by agent-stack: container.env + /etc/agent-stack/copilot-api.env (host-local
# secret: GATEWAY_MYSQL_PASSWORD) + cutover runtime overrides (HOST/PORT/MYSQL_HOST).
# NO secrets and NO host identities here — those are operator-provided per host.
#
# Gateway mode: a configured GATEWAY_MYSQL_* bundle switches auth + usage + the
# Copilot upstream credential onto agent-gateway's MySQL. GATEWAY_MYSQL_HOST is
# 127.0.0.1 on-host (cutover may re-inject it); the password is NEVER set here.

# ── agent-gateway MySQL (read client_keys/settings/usage write; read the
#    copilot account's access_token via v_proxy_accounts_v1) ──
GATEWAY_MYSQL_HOST=127.0.0.1
GATEWAY_MYSQL_PORT=3306
# The gateway database is reached over host loopback (containers run with
# --network host, nginx and MySQL both bind 127.0.0.1). Spelled GATEWAY_MYSQL_HOST
# explicitly rather than relying on cutover's COPILOT_API_MYSQL_HOST override:
# the proxy reads GATEWAY_* names, and a missing host makes readGatewayDbConfig
# return null, which silently disables key auth.
GATEWAY_MYSQL_HOST=127.0.0.1
GATEWAY_MYSQL_USER=copilot_api
GATEWAY_MYSQL_DATABASE=agent_gateway

# ── Local app home. In gateway mode the GitHub token comes from the DB; this
#    directory only backs the documented loopback / no-gateway file fallback and
#    holds config.json. It need not be a persisted mount (stateDir=null). ──
COPILOT_API_HOME=/root/.copilot-api

# ── Informational: the service's listen port. The container's actual bind is
#    driven by agent-stack (deploy.json "port" -> `--port 39526`); copilot-api
#    does not read COPILOT_API_PORT itself. Kept here so the port is discoverable
#    in one place alongside the other container env. ──
COPILOT_API_PORT=39526
