# copilot-api — PER-HOST values (secrets + host-specific non-secret overrides).
# Copy to /etc/agent-stack/copilot-api.env on each host, fill, chmod 600. Never committed.
#
#   sudo install -d -m700 /etc/agent-stack
#   sudo cp copilot-api/deploy/host.env.example /etc/agent-stack/copilot-api.env
#   sudo $EDITOR /etc/agent-stack/copilot-api.env    # fill every __FILL__
#   sudo chmod 600 /etc/agent-stack/copilot-api.env
#
# Uncommented KEY=__FILL__ is REQUIRED (assemble-env refuses without it).
# The value must match the password set for the copilot_api MySQL user on this
# host (agent-gateway mig 168 provisions the locked user; the operator sets its
# password + unlock out of band, then grants land via mig 168 + 169).

# ── Required secret ──
GATEWAY_MYSQL_PASSWORD=__FILL__

# ── Optional (loopback / no-gateway fallback ONLY; gateway mode reads the
#    GitHub token from provider_accounts.access_token, not from here) ──
# COPILOT_API_GITHUB_TOKEN=__FILL__       # only for standalone (non-gateway) mode
