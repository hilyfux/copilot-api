{
  "contract": "D-GATE（charge-preference.ts blockReason 八行决策表）跨仓测试向量",
  "version": 1,
  "note": "每个仓用同一组向量跑自己的 blockReason：expected=null 表示放行。row = D_GATE_TABLE 里第一个命中的行号。balance 档的「档有余量」就是「可花>0」，所以第 2 行被第 1 行先命中、实际不可达（保留在表里是为了和 spec §8.2 原表逐行对得上）。",
  "cases": [
    { "name": "订阅档窗口有余量 → 放行", "row": 1,
      "state": { "preference": "plan", "allowBalanceOverflow": false },
      "balances": { "windowExhausted": false, "tokenPackBalance": 0, "balanceMicros": 0 },
      "expected": null },
    { "name": "token 包有余量 → 放行", "row": 1,
      "state": { "preference": "token_pack", "allowBalanceOverflow": false },
      "balances": { "windowExhausted": true, "tokenPackBalance": 1, "balanceMicros": 0 },
      "expected": null },
    { "name": "余额档可花>0（赠送余额）→ 放行（第 1 行吸收第 2 行）", "row": 1,
      "state": { "preference": "balance", "allowBalanceOverflow": false },
      "balances": { "windowExhausted": true, "tokenPackBalance": 0, "balanceMicros": 1 },
      "expected": null },
    { "name": "余额档只有折算储值 → 放行", "row": 1,
      "state": { "preference": "balance", "allowBalanceOverflow": false },
      "balances": { "windowExhausted": false, "tokenPackBalance": 0, "balanceMicros": 0, "creditEquivalentMicros": 5 },
      "expected": null },
    { "name": "余额档可花=0 → insufficient_balance", "row": 3,
      "state": { "preference": "balance", "allowBalanceOverflow": true },
      "balances": { "windowExhausted": false, "tokenPackBalance": 9, "balanceMicros": 0 },
      "expected": "insufficient_balance" },
    { "name": "余额档透支为负、储值抵不上 → insufficient_balance", "row": 3,
      "state": { "preference": "balance", "allowBalanceOverflow": false },
      "balances": { "windowExhausted": false, "tokenPackBalance": 0, "balanceMicros": -10, "creditEquivalentMicros": 10 },
      "expected": "insufficient_balance" },
    { "name": "订阅耗尽、开关关、有买来的储值 → 放行（D4）", "row": 4,
      "state": { "preference": "plan", "allowBalanceOverflow": false },
      "balances": { "windowExhausted": true, "tokenPackBalance": 0, "balanceMicros": 0, "creditEquivalentMicros": 1 },
      "expected": null },
    { "name": "token 包耗尽、开关关、有储值 → 放行（D4）", "row": 4,
      "state": { "preference": "token_pack", "allowBalanceOverflow": false },
      "balances": { "windowExhausted": false, "tokenPackBalance": 0, "balanceMicros": -5, "creditEquivalentMicros": 3 },
      "expected": null },
    { "name": "订阅耗尽、开关关、只有赠送余额 → plan_exhausted_overflow_off", "row": 5,
      "state": { "preference": "plan", "allowBalanceOverflow": false },
      "balances": { "windowExhausted": true, "tokenPackBalance": 0, "balanceMicros": 100 },
      "expected": "plan_exhausted_overflow_off" },
    { "name": "token 包耗尽、开关关、只有赠送余额 → token_pack_exhausted_overflow_off", "row": 5,
      "state": { "preference": "token_pack", "allowBalanceOverflow": false },
      "balances": { "windowExhausted": false, "tokenPackBalance": 0, "balanceMicros": 100 },
      "expected": "token_pack_exhausted_overflow_off" },
    { "name": "订阅耗尽、开关关、什么都没有 → plan_exhausted_overflow_off", "row": 6,
      "state": { "preference": "plan", "allowBalanceOverflow": false },
      "balances": { "windowExhausted": true, "tokenPackBalance": 0, "balanceMicros": 0 },
      "expected": "plan_exhausted_overflow_off" },
    { "name": "token 包为负、开关关、什么都没有 → token_pack_exhausted_overflow_off", "row": 6,
      "state": { "preference": "token_pack", "allowBalanceOverflow": false },
      "balances": { "windowExhausted": true, "tokenPackBalance": -1, "balanceMicros": 0, "creditEquivalentMicros": 0 },
      "expected": "token_pack_exhausted_overflow_off" },
    { "name": "订阅耗尽、开关开、赠送余额>0 → 放行", "row": 7,
      "state": { "preference": "plan", "allowBalanceOverflow": true },
      "balances": { "windowExhausted": true, "tokenPackBalance": 0, "balanceMicros": 1 },
      "expected": null },
    { "name": "token 包耗尽、开关开、余额负但储值补正 → 放行", "row": 7,
      "state": { "preference": "token_pack", "allowBalanceOverflow": true },
      "balances": { "windowExhausted": false, "tokenPackBalance": 0, "balanceMicros": -2, "creditEquivalentMicros": 3 },
      "expected": null },
    { "name": "订阅耗尽、开关开、可花=0 → insufficient_balance", "row": 8,
      "state": { "preference": "plan", "allowBalanceOverflow": true },
      "balances": { "windowExhausted": true, "tokenPackBalance": 0, "balanceMicros": 0 },
      "expected": "insufficient_balance" },
    { "name": "token 包耗尽、开关开、余额负储值不够 → insufficient_balance", "row": 8,
      "state": { "preference": "token_pack", "allowBalanceOverflow": true },
      "balances": { "windowExhausted": true, "tokenPackBalance": 0, "balanceMicros": -3, "creditEquivalentMicros": 3 },
      "expected": "insufficient_balance" }
  ]
}
